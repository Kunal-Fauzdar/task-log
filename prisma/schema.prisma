// Prisma ORM v7: no `url`/`directUrl` here — connection strings live in prisma.config.ts
// and are supplied to PrismaClient at runtime via a driver adapter (see src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Plain `DateTime` (no @db.Timestamptz) maps to Postgres `timestamp(3)` WITHOUT time zone by
// default for the postgresql connector — this matches our "naive local wall-clock time, no
// timezone conversion" decision (see CLAUDE.md §3) without needing an explicit @db annotation.
// Don't "fix" these into @db.Timestamptz.

enum WorkDayStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  HOLIDAY
  LEAVE
}

// How the user has classified the day. WORKING is the default; HOLIDAY (a public/company
// holiday) and LEAVE (personal time off) are mutually exclusive — the /worklog day header
// offers them as a single "Day type" selector, not two independent toggles. Non-working days
// (weekends per AppSettings.workingDays) are NOT stored as a type — they're derived from the
// date at read time (see fillMissingExportDays / the Excel export's "WEEKLY OFF" rows).
enum WorkDayType {
  WORKING
  HOLIDAY
  LEAVE
}

enum TaskTimerStatus {
  NONE
  RUNNING
  PAUSED
  COMPLETED
}

enum SkillCategory {
  LESS_THAN_30
  BETWEEN_30_70
  MORE_THAN_70
}

/// An account. Registration is open (public sign-up), email is the login identifier, `name` is
/// the display name shown in the UI. Every domain row is owned by exactly one User via `userId`
/// (onDelete: Cascade) — see CLAUDE.md §3/§4 for the move from single-user to per-user data.
model User {
  id           String       @id @default(cuid())
  email        String       @unique
  name         String
  passwordHash String
  workDays     WorkDay[]
  skills       Skill[]
  projects     Project[]
  holidays     Holiday[]
  settings     AppSettings?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("users")
}

/// One row per calendar day the user has touched (started work, or marked a holiday).
/// Day-of-week is always derived from `date` at read time — never stored.
model WorkDay {
  id             String        @id @default(cuid())
  userId         String
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  date           DateTime      @db.Date
  checkIn        DateTime?
  checkOut       DateTime?
  breakSeconds   Int           @default(0)
  breakStartedAt DateTime?
  status         WorkDayStatus @default(NOT_STARTED)
  dayType        WorkDayType   @default(WORKING)
  // Free-text label/reason for a HOLIDAY or LEAVE day (e.g. "Independence Day", "Sick"). Was
  // `holidayReason`; renamed when LEAVE was added so it isn't holiday-specific.
  dayNote        String?
  notes          String?
  tasks          Task[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("work_days")
}

/// A single task entry within a WorkDay. `taskId` (e.g. "T-1039") is a free-text, validated
/// label — not globally unique, since the same Task ID can recur across different days.
model Task {
  id              String          @id @default(cuid())
  workDayId       String
  workDay         WorkDay         @relation(fields: [workDayId], references: [id], onDelete: Cascade)
  taskId          String
  description     String
  durationSeconds Int             @default(0)
  link            String?
  order           Int             @default(0)
  timerStatus     TaskTimerStatus @default(NONE)
  timerStartedAt  DateTime?
  // Optional project grouping. onDelete: SetNull — removing a Project unassigns its tasks
  // (they stay in their work days), never deletes them (user decision).
  projectId       String?
  project         Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  skills          TaskSkill[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([workDayId])
  @@index([taskId])
  @@index([projectId])
  @@map("tasks")
}

/// A project a task can be filed under. Per-user, spans all of that user's work days. The Excel
/// export can filter to a single project to produce a per-project timesheet; a task with no
/// project just contributes its day's timings to the default (all-projects) export.
model Project {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  description String?
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("projects")
}

/// `category` is always derived from `proficiencyPercentage` (see src/lib/domain/skill.ts) —
/// never set directly by callers, including the seed script.
model Skill {
  id                    String         @id @default(cuid())
  userId                String
  user                  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  category              SkillCategory
  proficiencyPercentage Int
  notes                 String?
  history               SkillHistory[]
  tasks                 TaskSkill[]
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@map("skills")
}

/// Append-only log of proficiency changes. Not written for the initial seed value — only for
/// actual changes after a Skill already exists (see src/lib/data/skill.ts).
model SkillHistory {
  id             String   @id @default(cuid())
  skillId        String
  skill          Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  fromPercentage Int
  toPercentage   Int
  changedAt      DateTime @default(now())

  @@index([skillId])
  @@map("skill_history")
}

/// Optional many-to-many association between a Task and the Skill(s) it involved.
model TaskSkill {
  taskId  String
  skillId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([taskId, skillId])
  @@index([skillId])
  @@map("task_skills")
}

/// Per-user config, one row per User (see src/lib/data/settings.ts, upsert-on-read keyed by
/// userId). Was a single `id = "singleton"` row when the app was single-user.
model AppSettings {
  id          String   @id @default(cuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Day-of-week numbers, 0 (Sunday) - 6 (Saturday), matching JS's Date#getUTCDay() convention
  /// already used everywhere else in this codebase (see isWeekend in src/lib/domain/date.ts).
  /// Drives which blank days a month/range Excel export fills in for days never logged — see
  /// fillMissingWorkingDays in src/lib/domain/workday.ts.
  workingDays Int[]    @default([1, 2, 3, 4, 5])
  updatedAt   DateTime @updatedAt

  @@map("app_settings")
}

/// Per-user reference calendar of known holidays (national/company), distinct from
/// WorkDay.dayType (the actual recorded status for a day) — see CLAUDE.md §3 for why separate.
model Holiday {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, date])
  @@index([userId])
  @@map("holidays")
}
