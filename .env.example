# Neon Postgres, provisioned via the Vercel-Neon marketplace integration (see DEPLOYMENT.md
# and CLAUDE.md §3 for why these exact variable names are kept rather than renamed).

# Pooled connection (hostname has "-pooler") — used by the running app for all queries.
DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?channel_binding=require&sslmode=require"

# Direct/unpooled connection (same hostname, no "-pooler") — used only by the Prisma CLI
# (migrate dev/deploy, db seed, Studio); the pooler doesn't support the DDL/session behavior
# migrations need.
DATABASE_URL_UNPOOLED="postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Auth (Phase 10) — single shared credential, no user table. Generate both values with:
#   npm run auth:hash-password -- 'your-chosen-password'
# The plaintext password itself is never stored anywhere, only its bcrypt hash — and that hash
# is base64-encoded before being put here, NOT the raw "$2b$12$..." string. Next.js's own .env
# loader (@next/env, via dotenv-expand) treats "$" as shell-style variable-expansion syntax and
# silently mangles a raw bcrypt hash into garbage; base64 has no "$" in its alphabet, so it's
# unaffected. The hash-password script already outputs it pre-encoded — don't paste a raw hash
# here directly.
AUTH_PASSWORD_HASH="base64-encoded-bcrypt-hash-goes-here"
SESSION_SECRET="random-hex-string-goes-here"
