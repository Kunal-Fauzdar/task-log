# Neon Postgres, provisioned via the Vercel-Neon marketplace integration (see DEPLOYMENT.md
# and CLAUDE.md §3 for why these exact variable names are kept rather than renamed).

# Pooled connection (hostname has "-pooler") — used by the running app for all queries.
DATABASE_URL="postgresql://USER:PASS@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?channel_binding=require&sslmode=require"

# Direct/unpooled connection (same hostname, no "-pooler") — used only by the Prisma CLI
# (migrate dev/deploy, db seed, Studio); the pooler doesn't support the DDL/session behavior
# migrations need.
DATABASE_URL_UNPOOLED="postgresql://USER:PASS@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require"

# Signs the stateless session cookie (HMAC-SHA256). Rotating this invalidates every session at
# once. Generate one with:  npm run auth:gen-secret
SESSION_SECRET="random-hex-string-goes-here"

# --- Local dev / test only (never set in Vercel) ---

# Skills seed owner. Defaults to kavya.b.analyst@gmail.com — the account the multi-user
# migration assigned all pre-existing data to.
# SEED_OWNER_EMAIL="you@example.com"
# SEED_OWNER_NAME="Your Name"

# The Playwright e2e suite registers/logs in as this account (e2e/auth.setup.ts).
E2E_TEST_EMAIL="e2e@worklog.test"
E2E_TEST_PASSWORD="a-long-enough-test-password"

# --- Optional: Google Sheet sync (DEPLOYMENT.md §12) ---
# Service account the app writes to users' sheets as. Leave unset to disable the feature.
# GOOGLE_SERVICE_ACCOUNT_EMAIL="worklog-sync@your-project.iam.gserviceaccount.com"
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Optional: "Connect Google account" for sheet sync (DEPLOYMENT.md §12 A, recommended) ---
# OAuth web client. Register redirect URI: <origin>/api/google/callback
# GOOGLE_OAUTH_CLIENT_ID="1234-abc.apps.googleusercontent.com"
# GOOGLE_OAUTH_CLIENT_SECRET="GOCSPX-..."
